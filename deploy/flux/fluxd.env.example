# Flux daemon configuration — /etc/flux/fluxd.env
#
# Read by the systemd unit as an EnvironmentFile. Values are literal: there is no
# shell here, so no quoting, no expansion, and no comments after a value.
#
# This file holds the database password. It should be mode 0640, owned by
# root:flux.

# --- Required ---------------------------------------------------------------

DATABASE_URL=postgres://flux:CHANGE-ME@127.0.0.1:5432/flux

# --- Backends ---------------------------------------------------------------

FLUX_ENGINE=trex
FLUX_PORTD=unix
FLUX_PORTD_SOCKET=/run/flux/portd.sock

# --- HTTP -------------------------------------------------------------------

FLUX_BIND=0.0.0.0:8080
FLUX_WEB_ROOT=/usr/share/flux/web

# Set to 1 once a certificate is configured. A Secure cookie sent over plain
# HTTP is dropped silently by the browser, which presents as a login that
# accepts the password and then bounces straight back to the login page.
FLUX_COOKIE_SECURE=0

FLUX_SESSION_TTL_HOURS=12

# --- TLS --------------------------------------------------------------------
#
# Where an uploaded certificate and its key are written. Serving over HTTPS is
# switched on by the presence of both files, not by a flag: an appliance told to
# use TLS with nothing to use is unreachable, which is the one failure this must
# not produce.
#
# Upload the material through Settings -> TLS rather than dropping files here,
# so it is checked before it is installed. Either way the listener is bound at
# startup, so a change needs `systemctl restart fluxd`.
#
# The directory must be writable by the flux user and readable by nobody else;
# the daemon writes the key mode 0600. Set FLUX_COOKIE_SECURE=1 at the same
# time.

FLUX_TLS_DIR=/etc/flux/tls

# --- First boot -------------------------------------------------------------
#
# Set this before the first start to choose the initial admin password.
# Otherwise fluxd generates one and writes it to the journal exactly once:
#
#     journalctl -u fluxd | grep -A4 'first administrator'
#
# Must be at least 12 characters. Remove this line once the account exists — it
# is only consulted when the users table is empty, so leaving it here does
# nothing except keep a password on disk.
#
# FLUX_BOOTSTRAP_ADMIN_PASSWORD=

# --- Time series ------------------------------------------------------------
#
# Where per-second samples are written and where the analytics page reads them
# back from. Runs and their results live in Postgres and do not depend on this:
# if VictoriaMetrics is down, tests still run and still report, and only the
# historical charts go blank.

FLUX_VM_URL=http://127.0.0.1:8428

# --- Logging ----------------------------------------------------------------

FLUX_LOG=info,fluxd=info,tower_http=warn
