# The appliance runs Linux. Everything in the repository is stored with LF and
# checked out with LF, including on Windows workstations — shell scripts, SQL
# run through psql, and systemd units all break on CRLF.
* text=auto eol=lf

# Binary assets, never touched.
*.png   binary
*.woff2 binary
*.ico   binary

# Generated; collapse it in diffs and reviews.
Cargo.lock      linguist-generated=true
web/package-lock.json linguist-generated=true
