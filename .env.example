# Flux daemon configuration.
#
# Copy to `.env` for local development (it is gitignored). On an appliance these
# same variables live in /etc/flux/fluxd.env, referenced by the systemd unit.

# --- Required ---------------------------------------------------------------

# Postgres connection string for the flux database.
DATABASE_URL=postgres://flux:flux@127.0.0.1:5432/flux

# --- Backends ---------------------------------------------------------------

# `mock` simulates ports and traffic entirely in process — no DPDK, no NIC, no
# root. `trex` drives real TRex instances. FLUX_PORTD follows FLUX_ENGINE unless
# it is set explicitly.
FLUX_ENGINE=mock
FLUX_PORTD=mock

# Control socket for the privileged helper. Only used when FLUX_PORTD=unix.
FLUX_PORTD_SOCKET=/run/flux/portd.sock

# --- HTTP -------------------------------------------------------------------

FLUX_BIND=127.0.0.1:8080

# Directory holding the exported Next.js build. In development, leave this
# pointing at web/out and use the Next dev server instead.
FLUX_WEB_ROOT=./web/out

# Set to 1 once TLS is in front of the daemon. A Secure cookie sent over plain
# HTTP is silently dropped by the browser, which looks exactly like a broken
# login — so this stays off until there is actually TLS.
FLUX_COOKIE_SECURE=0

# How long a session lasts after login.
FLUX_SESSION_TTL_HOURS=12

# --- First boot -------------------------------------------------------------

# Password for the `admin` account, created only when the users table is empty.
# Leave unset and fluxd generates one and prints it to the log exactly once.
# Must satisfy the password policy (12 characters or more).
# FLUX_BOOTSTRAP_ADMIN_PASSWORD=change-this-passphrase

# --- TLS --------------------------------------------------------------------

# Where a certificate uploaded through Settings -> TLS is written. HTTPS is
# switched on by both files being present, and the listener is bound at startup,
# so installing one needs a restart. In development the directory need not
# exist; nothing is written until something is uploaded.
FLUX_TLS_DIR=./target/flux-tls

# --- Mock engine ------------------------------------------------------------

# Speeds up the mock's clock. A 60-second trial honours its 60 seconds by
# default, which is correct on an appliance and tedious while developing.
# FLUX_MOCK_TIMESCALE=60

# --- Time series ------------------------------------------------------------

# Where per-second samples are written and where the analytics page reads them
# back. Runs and reports do not depend on it; only the historical charts do.
FLUX_VM_URL=http://127.0.0.1:8428

# --- Logging ----------------------------------------------------------------

# Standard tracing filter syntax.
FLUX_LOG=info,fluxd=debug,tower_http=info

# Set to `json` under systemd for structured journal entries.
# FLUX_LOG_FORMAT=json

# --- Database provisioning (used by `make db-setup` only) -------------------

# A superuser connection, used once to create the flux role and database.
# PGSUPERUSER_URL=postgres://postgres:PASSWORD@127.0.0.1:5432/postgres
